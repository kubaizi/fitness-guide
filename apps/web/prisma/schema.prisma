// The real database, on Neon Postgres.
//
// This grew out of docs/future-database-schema.prisma, which was a sketch
// written before there was a database. The differences from that sketch are
// deliberate and worth knowing:
//
//   - `Session` and `OtpCode` are gone. A session is a signed cookie (see
//     src/lib/session.ts), so there is nothing to store, and the one-time-code
//     login was dropped in favour of a username and password.
//   - `GymPhoto` is gone. A gym's photos are a plain string array, which is
//     what the pages actually read. When gyms start uploading their own photos
//     and an admin has to approve each one, that array becomes a table again:
//     a photo will then need a status and a reviewer, which an array cannot
//     hold.
//   - `User` gained username, passwordHash and passwordSalt, because that is
//     how people sign in today.
//
// Money is always an Int of fils. Never a Float: 0.1 + 0.2 is not 0.3 in
// binary floating point, and that is not a rounding error you want in a price.
// See packages/core/src/money.ts.
//
// The connection URL is NOT in this file. Prisma 7 takes it from
// prisma.config.ts, which reads it from .env. Nothing secret is committed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────────── enums

// Kuwait's six governorates. An enum rather than free text, so a typo cannot
// create a seventh one that quietly matches nothing.
enum Governorate {
  capital
  hawalli
  farwaniya
  ahmadi
  jahra
  mubarak_al_kabeer
}

// Who a gym lets in. `separate_sections` is one building with a men's floor
// and a women's floor; it shows under both Men and Women, and never under
// Mixed. The rule itself lives in packages/core/src/domain/gym.ts.
enum GymAccess {
  men
  women
  mixed
  separate_sections
}

enum VerificationState {
  unverified
  pending
  verified
  rejected
}

enum PlanDuration {
  day_pass
  monthly
  quarterly
  half_yearly
  yearly
}

enum MembershipState {
  pending_payment
  active
  frozen
  expired
  cancelled
}

enum UserRole {
  member
  gym_staff
  gym_owner
  admin
}

// ─────────────────────────────────────────────────────────────────── models

model User {
  id String @id @default(cuid())

  // How people sign in. Unique, and written lowercase by the code that saves
  // it — Postgres compares text case-sensitively, so "Emad" and "emad" would
  // otherwise be two different accounts.
  username     String @unique
  // scrypt. The salt is per user and not secret; the hash is. Neither one ever
  // goes to the browser.
  passwordHash String
  passwordSalt String

  // Phone is the main identity in this market, not email. Optional because an
  // internal account (the admin) may not have one. Postgres allows many NULLs
  // in a unique column, so several users without a phone is fine.
  phone String? @unique
  email String? @unique
  name  String
  // Optional: it is asked for in the profile, and the profile is optional. It
  // does not filter what a member can see — a women's gym is visible to
  // everyone (docs/product-decisions.md).
  gender      String?
  dateOfBirth DateTime? @db.Date
  occupation  String?
  role        UserRole  @default(member)
  locale      String    @default("ar")

  /// The profile picture, as a `data:image/...;base64,` string.
  ///
  /// Stored in the row rather than in object storage, deliberately. The
  /// browser shrinks the image to 256px before sending, which lands around
  /// 20–40 KB — small enough that a column is honest, and it needs no second
  /// service, no bucket and no card on file. When this platform has thousands
  /// of members it moves to real object storage and this column holds a URL
  /// instead; nothing else has to change, because it is a string either way.
  ///
  /// A profile picture ONLY — the one image other people are meant to see.
  /// Body and progress photos live in ProgressPhoto below, which is private,
  /// and they are kept apart on purpose: the moment those two share a column,
  /// one careless query shows a private photo in a public place.
  photo String?

  /// Social handles, not URLs. The link is built from these, so a stored value
  /// can only ever point at that network — where a URL field would happily
  /// hold `javascript:` or a link anywhere at all.
  instagram String?
  x         String?
  snapchat  String?
  tiktok    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  reviews     Review[]
  checkIns    CheckIn[]
  weights     WeightEntry[]
  photos      ProgressPhoto[]
  medical     MedicalFile?
  reports     MedicalReport[]
  // A gym owner or staff member is linked to the gym they work at.
  staffAtGym   Gym?    @relation("GymStaff", fields: [staffAtGymId], references: [id])
  staffAtGymId String?

  @@index([staffAtGymId])
}

/// One weighing, on one day.
///
/// ── This is health data, and it is treated as such ──
/// Emad listed weight under the profile rather than the medical file, but a
/// record of someone's body over time is health data by any ordinary reading.
/// The confirmed rule for the medical section is that nobody at Fitness Guide
/// may read it, admins included (docs/product-decisions.md).
///
/// So this table is deliberately absent from every admin query. The member
/// sees their own history and nobody else does. If Emad decides in writing
/// that weight is ordinary profile data, that is a change to make then — the
/// safe reading costs nothing now.
model WeightEntry {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Grams, as an integer. The same discipline as money in fils, for the same
  /// reason: 82.5 stored as a float is not exactly 82.5, and a weight chart
  /// that drifts is worse than useless. 82.5 kg is 82500.
  grams Int

  /// The day it was measured, not the day it was typed in. Someone entering
  /// last Friday's weighing should see it on Friday.
  measuredOn DateTime @db.Date

  createdAt DateTime @default(now())

  /// One weighing per person per day. A second entry for the same day replaces
  /// the first rather than sitting beside it, which is what someone means when
  /// they correct a number they mistyped.
  @@unique([userId, measuredOn])
  @@index([userId, measuredOn])
}

/// `onDelete: Cascade` above is doing real work: deleting the account erases
/// the weight history with it, which is rule 1 of the medical decisions.

/// A photo the member took of themselves. Private.
///
/// Emad's earlier decision said the profile picture was a profile picture only,
/// "not body or progress photos, which would need the same protection as
/// medical data". He has now asked for them, and answered that objection in the
/// same breath: private, visible only to the member. So they are built under
/// the medical rules rather than beside the avatar.
///
/// No admin query touches this table, and there is no function that reads
/// another member's photos.
model ProgressPhoto {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// A `data:image/...;base64,` string, shrunk by the browser before sending.
  /// See the note at the bottom of this file about where this has to go next.
  image String
  /// The member's own caption. Optional, like everything else here.
  note  String?

  takenOn   DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, takenOn])
}

/// The member's answers to the health questions. One per member.
///
/// Every field is optional, including the whole row — a member who never opens
/// this section has no MedicalFile at all, which is the honest representation
/// of "they have not told us anything".
///
/// Read the four confirmed rules in docs/product-decisions.md before touching
/// this. The one that shapes the code is rule 2: nobody at Fitness Guide may
/// read it, admins included.
model MedicalFile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// One file per member, enforced by the database rather than by remembering.
  userId String @unique

  /// Free text, not a checklist. "Do you have allergies?" has a thousand
  /// answers and a member describing theirs in their own words is far more use
  /// to a doctor than a tick-box we invented.
  allergies       String?
  disabilities    String?
  chronicInjuries String?
  medications     String?
  /// "O+", "AB-". Short and standard, so a plain string is enough.
  bloodType       String?
  /// Anything the questions above did not ask about.
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A scan or photo of a medical report. Private, under the same rules.
model MedicalReport {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// What it is, in the member's words — "blood test, March".
  title String
  /// A `data:` string: an image the browser shrunk, or a small PDF as-is.
  content String
  /// "image" or "pdf". Decides whether the page shows it or offers it as a
  /// download, and is stored rather than parsed back out of the data URI.
  kind String

  uploadedAt DateTime @default(now())

  @@index([userId, uploadedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// A LIMIT WORTH KNOWING ABOUT, on the three columns above that hold files.
///
/// `photo`, `ProgressPhoto.image` and `MedicalReport.content` all store the
/// file itself, base64-encoded, inside the row. For one small avatar that is a
/// fair trade — no bucket, no second service, no card on file.
///
/// A gallery is a different size of problem. Twelve progress photos and six
/// reports is a few megabytes per member, and Neon's free plan holds half a
/// gigabyte. That is fine for a demo and will not do for a real membership.
/// The caps in the actions exist to keep this survivable, not because they are
/// the right product answer.
///
/// Before real members arrive, these three move to object storage and the
/// columns hold URLs instead. Nothing else changes, because a column that
/// holds a data URI and a column that holds a URL are both just strings.
/// ─────────────────────────────────────────────────────────────────────────

model Gym {
  id   String @id @default(cuid())
  slug String @unique

  // Bilingual content is a pair of columns rather than a JSON blob, so the
  // database can index and search each language on its own.
  nameAr        String
  nameEn        String
  descriptionAr String
  descriptionEn String
  areaAr        String
  areaEn        String
  addressAr     String
  addressEn     String
  hoursAr       String
  hoursEn       String

  governorate Governorate
  access      GymAccess

  verification VerificationState @default(unverified)
  verifiedAt   DateTime?
  // Filled in only when verification is `rejected` — the gym is shown this.
  rejectionReason String?
  submittedAt     DateTime?

  // Copied from Review on purpose: every gym card in a list needs these, and
  // working out an average per card would be one extra query per card.
  // Recalculated whenever a review is written.
  rating      Float?
  reviewCount Int    @default(0)

  latitude  Float
  longitude Float

  // Amenity keys, not display text — "sauna", "parking". The words come from
  // packages/i18n, so they are translated rather than stored twice.
  amenities String[]
  // Image paths. See the note at the top about why this is not a table yet.
  photos    String[]

  // Whether the doors are open right now. A cached answer, not the truth: the
  // truth is the opening hours, which are free text today because a gym in
  // Kuwait describes them in its own words.
  openNow Boolean @default(true)

  // Per-gym override of the platform commission, in basis points
  // (1000 = 10%). Null means "use the platform default", so a launch partner
  // can get a lower rate without hardcoding it per gym.
  commissionBps Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans       MembershipPlan[]
  memberships Membership[]
  reviews     Review[]
  checkIns    CheckIn[]
  staff       User[]           @relation("GymStaff")

  // Listing queries filter on these constantly.
  @@index([governorate, access])
  @@index([verification])
}

model MembershipPlan {
  id    String @id @default(cuid())
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId String

  nameAr   String
  nameEn   String
  duration PlanDuration

  /// Fils. What the gym charges normally.
  listPrice  Int
  /// Fils. The app-only price. Null when no offer is running.
  offerPrice Int?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([gymId, active])
}

model Membership {
  id     String         @id @default(cuid())
  user   User           @relation(fields: [userId], references: [id])
  userId String
  gym    Gym            @relation(fields: [gymId], references: [id])
  gymId  String
  plan   MembershipPlan @relation(fields: [planId], references: [id])
  planId String

  state MembershipState @default(pending_payment)

  // Nullable because which dates exist depends on the state — an unpaid
  // membership has no start date, a cancelled one has no end date.
  startsOn    DateTime?
  endsOn      DateTime?
  frozenAt    DateTime?
  resumesOn   DateTime?
  cancelledAt DateTime?
  endedOn     DateTime?

  /// Fils. What the member actually paid, saved at purchase time so a later
  /// price change never rewrites history.
  pricePaid    Int
  /// Fils. Refunded amount, when cancelled.
  refundAmount Int?

  // The rotating value behind the QR code. Never the membership id, so a
  // leaked screenshot cannot be reused forever.
  checkInToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment  Payment?
  checkIns CheckIn[]
  review   Review?

  @@index([userId, state])
  @@index([gymId, state])
}

model Payment {
  id           String     @id @default(cuid())
  membership   Membership @relation(fields: [membershipId], references: [id])
  membershipId String     @unique

  /// Fils. The full amount charged to the customer.
  amount        Int
  /// Fils. The platform's commission on this payment.
  platformFee   Int
  /// Fils. What the gym is owed. platformFee + gymAmount must equal amount.
  gymAmount     Int
  /// Basis points actually applied, saved so a later rate change does not
  /// alter what a gym was owed in the past.
  commissionBps Int

  // "myfatoorah" | "tap" — text, so swapping gateway needs no migration.
  provider    String
  providerRef String? @unique
  // "knet" | "card"
  method      String?
  status      String  @default("pending")

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

model CheckIn {
  id           String     @id @default(cuid())
  membership   Membership @relation(fields: [membershipId], references: [id])
  membershipId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  gym          Gym        @relation(fields: [gymId], references: [id])
  gymId        String

  scannedAt DateTime @default(now())

  // Attendance history and streaks are built from this table — it is the
  // daily-engagement signal, so it gets queried a lot.
  @@index([userId, scannedAt])
  @@index([gymId, scannedAt])
}

/// One row per sign-in or sign-up attempt, so the app can refuse a source that
/// is trying too often. See src/lib/rate-limit.ts for the policy.
///
/// A log of attempts rather than a running counter. A counter is fewer rows,
/// but it needs read-then-write to increment, which two requests arriving
/// together can get wrong. Inserting a row cannot be got wrong, and counting
/// them is one indexed query. The cost is rows to tidy up, which the same file
/// does as it goes.
model AttemptLog {
  id String @id @default(cuid())

  /// What is being counted — today the caller's IP address.
  key String
  /// Which action: "signin" or "signup".
  kind String

  createdAt DateTime @default(now())

  // Every query asks the same question: how many rows of this kind, for this
  // key, since this time. The index answers it in that order.
  @@index([kind, key, createdAt])
}

model Review {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  gym    Gym    @relation(fields: [gymId], references: [id])
  gymId  String
  // One review per membership: you review the gym you actually paid to use,
  // and only once.
  membership   Membership @relation(fields: [membershipId], references: [id])
  membershipId String     @unique

  rating Int
  body   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gymId, createdAt])
}
