# Copy to .env and fill in. `.env` is git-ignored; this file is not.
#
# SESSION_SECRET is the ONLY variable the app needs. There is no database and
# no connection string — the data lives in apps/web/db/*.json.

# Signs the session cookie. Must be at least 32 characters, and must be the
# same value everywhere a given set of cookies has to stay valid: change it and
# every signed-in user is signed out, because their cookie no longer verifies.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# On Vercel this goes in Settings > Environment Variables, applied to
# Production, Preview and Development. Without it the site still browses, but
# signing in throws a server error.
SESSION_SECRET=replace-me-with-at-least-32-random-characters
