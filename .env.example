# The demo reads data from JSON files in apps/web/db/ - there is no database,
# so there is no DATABASE_URL. See docs/future-database-schema.prisma for the
# schema to use when a real backend is added.

# Signs the session cookie. Any random 32+ character string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
